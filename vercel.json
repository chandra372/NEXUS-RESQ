{
  "version": 2,
  "installCommand": "npm --prefix nexus-resq/frontend install",
  "buildCommand": "npm --prefix nexus-resq/frontend run build",
  "outputDirectory": "nexus-resq/frontend/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
